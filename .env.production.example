# Campus Hub - Production Environment Variables
# Copy this file to .env.production and fill in your actual values
# These variables should be configured in the Vercel dashboard

# ==========================================
# API Configuration
# ==========================================
# Your Railway backend API URL
VITE_API_URL=https://your-backend-url.railway.app

# WebSocket URL (usually same as API URL but with ws:// or wss://)
VITE_WS_URL=wss://your-backend-url.railway.app

# ==========================================
# Payment Configuration
WEBHOOK_SECRET=your_webhook_secret_here
VITE_PAYMENT_KEY_ID=your_payment_key_id

# ==========================================
# Cloudinary Configuration (for file uploads)
# ==========================================
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ==========================================
# Optional: Analytics & Monitoring
# ==========================================
# Google Analytics Measurement ID (optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking (optional)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ==========================================
# Optional: Feature Flags
# ==========================================
# Enable/disable features
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_NOTIFICATIONS=true
